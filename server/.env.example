PORT=8787

# 方舟大模型：API Key 与模型 ID
# 模型需支持音频理解，推荐 doubao-seed-2-1-lite-260915（也可填自定义接入点 ep-xxx）
ARK_API_KEY=
ARK_MODEL_ID=doubao-seed-2-1-lite-260915

# 可选：音频转写单独指定模型，留空则复用 ARK_MODEL_ID
ASR_MODEL_ID=
# 可选：调用超时（毫秒）与 JSON 解析失败后的重试次数
ARK_TIMEOUT_MS=60000
ARK_MAX_RETRIES=1

# 火山录音文件识别（备用 ASR 方案，方舟音频理解不需要，留空即可）
ASR_APP_ID=
ASR_ACCESS_TOKEN=

CORS_ORIGIN=http://localhost:8787
STORE_DRIVER=sqlite
ASSOCIATION_THRESHOLD=70
UPLOAD_LIMIT_MB=25
